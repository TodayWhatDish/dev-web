{
    // dev-data-embed(백엔드, 8000)가 이미 떠 있어야 관리자·고객 페이지의 fetch가 성공한다.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🌐 프론트 개발 서버 (3000)",
            "detail": "Next.js 개발 서버를 띄운다(localhost:3000). 처음이면 npm install 을 먼저 한다.",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "🛑 포트 3000 죽이기"
            ],
            "dependsOrder": "sequence",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "🛑 포트 3000 죽이기",
            "detail": "개발 서버가 창을 닫아도 안 죽고 남아 포트를 잡고 있을 때 쓴다.",
            "type": "shell",
            "command": "lsof -ti:3000 | xargs kill -9",
            // Windows 엔 lsof 가 없다 - PowerShell 로 3000 을 잡은 프로세스를 찾아 끈다
            "windows": {
                "command": "Get-NetTCPConnection -LocalPort 3000 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }"
            },
            "problemMatcher": [],
            "presentation": {
                "clear": true
            }
        }
    ]
}
